{%- comment -%}
  Wooffy article calls to action. Generated by scripts/build_theme_cta_snippet.py from
  breed-quiz-data.json (171 quiz breeds) - edit the script, not this output.
  Theme editor -> Blog posts -> Default blog post -> Custom Liquid section under "Blog post"
  (padding 0/0). Renders nothing on other articles.
{%- endcomment -%}
{%- if article -%}
  {%- assign wf_handle = article.handle | split: '/' | last -%}
  {%- if wf_handle contains '-first-year-costs' -%}
    {%- assign wf_breed = wf_handle | remove: '-first-year-costs' -%}
    <div class="page-width page-width--narrow">
      <div style="background:#faf7f2;border:1px solid rgba(0,0,0,0.08);border-radius:16px;padding:20px 22px;margin:8px 0 32px;">
        <p style="margin:0 0 6px;font-weight:700;font-size:17px;line-height:1.4;color:#1a1a1a;">Estimate your own first-year costs</p>
        <p style="margin:0 0 14px;font-size:15px;line-height:1.6;color:#5c6166;">Change where you live, breeder or rescue, insurance and grooming. The calculator adds up every line item for this breed.</p>
        <a href="/pages/dog-cost-calculator?breed={{ wf_breed | url_encode }}" style="display:inline-block;background:#108474;color:#ffffff;font-weight:700;font-size:15px;padding:11px 20px;border-radius:10px;text-decoration:none;">Open the cost calculator</a>
      </div>
    </div>
