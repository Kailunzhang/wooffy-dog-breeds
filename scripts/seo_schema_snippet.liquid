{%- comment -%}
  Article JSON-LD for Wooffy (2026-07-14 audit fix #03). ARTICLE PAGES ONLY.

  The theme (Dawn) already emits its own schema natively:
    - sections/header.liquid      -> Organization (sitewide) + WebSite (index)
    - sections/main-article.liquid-> Article via {{ article | structured_data }}
    - sections/main-product.liquid-> Product
  To end up with exactly one Article + one Organization we:
    1) keep seo-brand-context.liquid as the single rich Organization
       (@id {{ shop.url }}/#organization),
    2) DISABLE header.liquid's Organization block and main-article's
       {{ article | structured_data }} (comment them out),
    3) emit the article schema HERE with the real updated_at as
       dateModified + a BreadcrumbList, referencing the brand-context @id.

  This snippet intentionally emits NOTHING on non-article pages so it never
  duplicates Dawn's native Product / index WebSite schema.
{%- endcomment -%}

{%- if request.page_type == 'article' -%}
{%- liquid
  assign org_id = shop.url | append: '/#organization'
  assign site_id = shop.url | append: '/#website'
-%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": {{ site_id | json }},
      "url": {{ shop.url | json }},
      "name": {{ shop.name | json }},
      "publisher": { "@id": {{ org_id | json }} }
    },
    {
      "@type": "BlogPosting",
      "@id": "{{ canonical_url }}#article",
      "isPartOf": { "@id": {{ site_id | json }} },
      "mainEntityOfPage": { "@type": "WebPage", "@id": {{ canonical_url | json }} },
      "headline": {{ article.title | json }},
      "description": {{ page_description | default: article.excerpt_or_content | strip_html | strip_newlines | strip | truncate: 200 | json }},
      {%- if article.image -%}
      "image": "https:{{ article.image | image_url: width: 1200 }}",
      {%- endif -%}
      "datePublished": {{ article.published_at | date: "%Y-%m-%dT%H:%M:%S%z" | json }},
      "dateModified": {{ article.updated_at | date: "%Y-%m-%dT%H:%M:%S%z" | json }},
      "author": { "@id": {{ org_id | json }} },
      "publisher": { "@id": {{ org_id | json }} }
    },
    {
      "@type": "BreadcrumbList",
      "@id": "{{ canonical_url }}#breadcrumb",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ shop.url | json }} },
        { "@type": "ListItem", "position": 2, "name": {{ blog.title | json }}, "item": "{{ shop.url }}/blogs/{{ blog.handle }}" },
        { "@type": "ListItem", "position": 3, "name": {{ article.title | json }}, "item": {{ canonical_url | json }} }
      ]
    }
  ]
}
</script>
{%- endif -%}
